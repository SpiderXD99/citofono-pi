[Unit]
Description=Citofono - pagina dei PIN
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/citofono/server.py --conf /etc/citofono/citofono.conf
Restart=on-failure
RestartSec=3
# gira come root: deve legarsi alla porta 443, leggere il token (600) e
# comandare il servizio del tunnel. E' un apparecchio dedicato a questo solo scopo.
User=root
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=multi-user.target
